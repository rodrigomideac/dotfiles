FROM debian:12

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive

# Install git early so we can set up the local repo for testing
RUN apt-get update && apt-get install -y git

# Copy dotfiles repository and commit any uncommitted changes for clone
COPY . /tmp/dotfiles-repo/
RUN cd /tmp/dotfiles-repo && \
    git config user.email "test@test" && \
    git config user.name "test" && \
    git add -A && \
    git commit -m "test" --allow-empty

# Allow all users to clone from this repo
RUN git config --system --add safe.directory '*'

# Use local repo instead of GitHub for testing
ENV DOTFILES_REPO_URL=/tmp/dotfiles-repo

# Skip interactive prompts in Docker
ENV BOOTSTRAP_YES=1

# Copy bootstrap script and assertions to a location in PATH.
# bootstrap.sh runs in remote mode here (not inside ~/.dotfiles), so it will
# clone the repo to ~/.dotfiles and re-exec itself in local mode.
COPY bootstrap/bootstrap.sh /usr/local/bin/bootstrap.sh
COPY bootstrap/test/assertions.sh /usr/local/bin/assertions.sh
RUN chmod +x /usr/local/bin/bootstrap.sh /usr/local/bin/assertions.sh

# Test 1: Run bootstrap as root (remote mode → clone → local mode → full setup)
RUN bootstrap.sh

# Test 2: Create non-root user and test idempotency
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:123456" | chpasswd && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER testuser
WORKDIR /home/testuser
RUN bootstrap.sh

# Run validation assertions
RUN assertions.sh

# Default command: Start zsh to verify it works
CMD ["/usr/bin/zsh", "-c", "echo 'Bootstrap successful! Zsh is running.'"]
