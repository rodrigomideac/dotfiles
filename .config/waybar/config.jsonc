{
  "layer": "top",
  "position": "top",
  "height": 65,
  "spacing": 1,
  "margin": 0,
  "modules-left": [
    "niri/workspaces",
    "niri/window",
    "custom/weather",
    "custom/weather-tomorrow"
  ],
  "modules-center": [
    "custom/playerctl"
  ], //battery   //disk     // uptime      //updates        // systray
  "modules-right": [
    "pulseaudio",
    // "backlight",
    "network",
    "cpu",
    "memory",
    // "temperature",
    "battery",
    // "disk",
    // "custom/uptime",
    // "custom/updates",
    "tray",
    "clock",
    "custom/power"
  ],
  // all-outputs is false so each bar describes its own screen: the anchors on
  // HDMI-A-1, the Jira-keyed task workspaces on DP-3.
  //
  // format-icons match on the workspace name, so only the anchors get their own
  // glyph; task workspaces are named after a ticket and fall through to the
  // state icons. This module has no "rewrite" and no "tooltip", and {value}
  // prints in full -- which is why a workspace is named with the bare ticket
  // key while the summary lives in the picker instead.
  "niri/workspaces": {
    "all-outputs": false,
    "format": "{icon} {value}",
    "format-icons": {
      "comm-tools": "󰭹",
      "slack": "",
      "personal": "󰖟",
      "focused": "",
      "active": "",
      "urgent": "",
      "empty": "",
      "default": ""
    }
  },
  // The only context line. With IntelliJ focused this reads
  // "<slug>-<ticket> - Foo.java", naming the ticket the workspace belongs to.
  "niri/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "custom/playerctl": {
    "format": " 󰐊 {}",
    "return-type": "json",
    "max-length": 40,
    "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{artist}} - {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
  },
  "custom/weather": {
    "exec": "curl 'wttr.in/Jacarei-SP?format=%l:+%C+%t+(feels+like+%f)'",
    "interval": 3600,
    "format": "{}",
    "tooltip": true
  },
  "custom/weather-tomorrow": {
    "exec": "curl -s 'wttr.in/Jacarei-SP?format=j1' | jq -r '.weather[1] | \"Tomorrow: \\(.avgtempC)°C \\(.hourly[4].weatherDesc[0].value)\"'",
    "interval": 3600,
    "format": "{}",
    "tooltip": true
  },
  "custom/updates": {
    "format": "󰚰 {}",
    "exec": "checkupdates | wc -l",
    "interval": 3600,
    "on-click": "alacritty -e sudo pacman -Syu",
    "signal": 8
  },
  "custom/uptime": {
    "format": "󰔟 {}",
    "exec": "uptime -p | sed 's/up //; s/ days/d/; s/ hours/h/; s/ minutes/m/'",
    "interval": 60
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "tooltip": true
  },
  "clock": {
    "format": "󰥔 󰃮 {:%Y-%m-%d  %H:%M}",
    "format-alt": "󰃮 {:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#d3c6aa'><b>{}</b></span>",
        "days": "<span color='#e67e80'>{}</span>",
        "weeks": "<span color='#a7c080'><b>W{}</b></span>",
        "weekdays": "<span color='#7fbbb3'><b>{}</b></span>",
        "today": "<span color='#dbbc7f'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "cpu": {
    "format": "󰘚 {usage}%",
    "tooltip": true,
    "interval": 1,
    "on-click": "alacritty -e htop"
  },
  "memory": {
    "format": "󰍛 {}%",
    "interval": 1,
    "on-click": "alacritty -e htop"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": [
      "󱃃",
      "󰔏",
      "󱃂"
    ],
    "on-click": "alacritty -e s-tui"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "network": {
    "format-wifi": "󰖩 {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰖪 Disconnected",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "alacritty -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰂲 {icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰥰",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰄝",
      "car": "󰄋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "disk": {
    "interval": 30,
    "format": "󰋊 {percentage_used}%",
    "path": "/",
    "on-click": "alacritty -e gdu /"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 5
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
