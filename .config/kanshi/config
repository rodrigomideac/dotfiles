output "Ancor Communications Inc VX248 G3LMQS023518" {
  mode 1920x1080
  position 1280,0
  scale 1 
  alias $HOME_LEFT
}

output "PNP(AOC) 24G2W1G4 0x000004ED" {
  mode 1920x1080@144.001
  position 0,0
  scale 1
  alias $HOME_CENTER
}

output "BOE 0x0A35 Unknown" {
  alias $LAPTOP
}

profile home_desk {
  output $LAPTOP disable
  output $HOME_LEFT enable
  output $HOME_CENTER enable
}

profile mobile {
  output $LAPTOP enable
}

