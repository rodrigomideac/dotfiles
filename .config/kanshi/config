output "Ancor Communications Inc VX248 G3LMQS023518" {
  mode 1920x1080
  position -1920,0
  scale 1
  alias $HOME_LEFT
}

output "PNP(AOC) 24G2W1G4 0x000004ED" {
  mode 1920x1080@144.001
  position 0,0
  scale 1
  alias $HOME_CENTER
}

output "PNP(VCS) Connector 0x00451531" {
  alias $NANOKVM
}

profile desk_pc_kvm {
  output $HOME_CENTER enable
  output $NANOKVM disable
}

profile desk_pc {
  output $HOME_CENTER enable
  output $HOME_LEFT enable
}
