output "Ancor Communications Inc VX248 G3LMQS023518" {
  mode 1920x1080
  position 1920,0
  scale 1
  alias $HOME_RIGHT
}

output "PNP(AOC) 24G2W1G4 0x000004ED" {
  mode 1920x1080@144.001
  position 0,0
  scale 1
  alias $HOME_CENTER
}

output "Lenovo Group Limited 0x403D Unknown" {
  alias $LAPTOP
}

profile home_desk {
  output $LAPTOP disable
  output $HOME_RIGHT enable
  output $HOME_CENTER enable
}

profile home_desk_alternative {
  output $LAPTOP disable
  output $HOME_CENTER enable
}

profile mobile {
  output $LAPTOP enable
}

