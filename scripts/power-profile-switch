#!/bin/bash

set -euo pipefail

POWER_SUPPLY_STATUS="/sys/class/power_supply/AC/online"

if [[ ! -f "$POWER_SUPPLY_STATUS" ]]; then
    logger -t power-profile-switch "ERROR: AC power supply status file not found at $POWER_SUPPLY_STATUS"
    exit 1
fi

ac_online=$(cat "$POWER_SUPPLY_STATUS")

if [[ "$ac_online" == "1" ]]; then
    desired="performance"
else
    desired="power-saver"
fi

current=$(powerprofilesctl get 2>/dev/null || echo "unknown")

if [[ "$current" == "$desired" ]]; then
    exit 0
fi

logger -t power-profile-switch "AC online=$ac_online, switching profile $current -> $desired"
powerprofilesctl set "$desired"

notify_body="$current -> $desired (AC online=$ac_online)"

if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    notify-send "Power Profile" "$notify_body" --icon=battery
else
    for uid in /run/user/*/; do
        uid_num=$(basename "$uid")
        sudo -u "#$uid_num" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=${uid}bus" \
            notify-send "Power Profile" "$notify_body" --icon=battery 2>/dev/null || true
    done
fi
