#!/bin/bash

# Default http(s) handler.
#
# Chrome already reuses a running instance, but it hands the URL to whichever
# Chrome window was last active. A normal tabbed window gets a new tab; a
# PWA/app window (app id "chrome-<app>-<profile>") can't host tabs, so Chrome
# opens a whole new window on some other workspace instead — and Wayland won't
# let it raise itself either.
#
# Focusing a real tabbed window first makes it deterministic: the URL lands as
# a tab in the window you're now looking at. Any failure just falls through to
# plain Chrome, so opening a link never depends on this working.

BROWSER=google-chrome-stable

focus_tabbed_chrome() {
    command -v niri > /dev/null || return

    # Prefer a Chrome window on the workspace you're on, else any of them.
    # Bare "google-chrome" is a normal tabbed window; PWAs get their own app id.
    local ws id
    ws=$(niri msg --json workspaces 2>/dev/null |
        jq -r 'map(select(.is_focused)) | first | .id // -1') || return
    id=$(niri msg --json windows 2>/dev/null |
        jq -r --argjson ws "${ws:--1}" '
            map(select(.app_id == "google-chrome"))
            | (map(select(.workspace_id == $ws)) + .)
            | first | .id // empty') || return

    [[ -n "$id" ]] && niri msg action focus-window --id "$id" > /dev/null 2>&1
}

focus_tabbed_chrome
exec "$BROWSER" "$@"
