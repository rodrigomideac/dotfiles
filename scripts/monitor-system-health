#!/bin/bash
# System Health Monitoring Script
# Runs periodic checks and notifies on failures with spam prevention

set -euo pipefail

# Reusable check function
# Args:
#   $1 - script_path: Path to the check script to execute
#   $2 - user_message: User-friendly message for notification
#   $3 - cooldown_mins: Minutes between notifications (default: 5)
check() {
    local script_path="$1"
    local user_message="$2"
    local cooldown_mins="${3:-5}"

    # Run check script and capture output
    local output
    local exit_code
    if output=$("$script_path" 2>&1); then
        exit_code=0
    else
        exit_code=$?
    fi

    if [ $exit_code -ne 0 ]; then
        # Check script failed - handle notification with spam prevention
        local script_name="${script_path##*/}"
        local state_file="/tmp/monitoring-${script_name}.state"
        local now=$(date +%s)
        local last_notified=0

        # Read last notification time if exists
        if [ -f "$state_file" ]; then
            last_notified=$(cat "$state_file" 2>/dev/null || echo 0)
        fi

        local cooldown_seconds=$((cooldown_mins * 60))
        local time_since_last=$((now - last_notified))

        # Send notification if cooldown period has expired
        if [ $time_since_last -gt $cooldown_seconds ]; then
            # Get DISPLAY from user session (fallback to :0)
            local display="${DISPLAY:-:0}"

            # Send critical notification
            DISPLAY="$display" notify-send -u critical \
                "ERROR: $user_message" \
                "$output" 2>/dev/null || true

            # Update state file with current timestamp
            echo "$now" > "$state_file"

            # Log notification sent
            echo "Notification sent for $script_name (last was ${time_since_last}s ago)"
        else
            local remaining=$((cooldown_seconds - time_since_last))
            echo "Skipping notification for $script_name (cooldown: ${remaining}s remaining)"
        fi

        # Always log failure to systemd journal for debugging
        systemd-cat -t monitor-system-health -p warning \
            echo "Check failed: $script_path (exit code: $exit_code)"

        return 1
    else
        # Check passed - clear any existing state file
        local script_name="${script_path##*/}"
        local state_file="/tmp/monitoring-${script_name}.state"

        if [ -f "$state_file" ]; then
            rm -f "$state_file"
            echo "Check recovered: $script_path"
        fi

        return 0
    fi
}

# Main execution
main() {
    # Check Solaar diagnostics (Logitech device configuration)
    check "/home/rodrigo/dev-pessoal/dotfiles/udev/solaar-diag.sh" \
          "Logitech device configuration issue" 5

    # Add more checks here as needed:
    # check "/path/to/another/script" "Description of check" 10
}

# Run main function
main
